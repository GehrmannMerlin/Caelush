{
  "name": "@caelush/ui-theme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./appearance": {
      "types": "./dist/appearance.d.ts",
      "import": "./dist/appearance.js"
    },
    "./appearance-selector": {
      "types": "./dist/appearance-mode-selector.d.ts",
      "import": "./dist/appearance-mode-selector.js"
    },
    "./brand": {
      "types": "./dist/brand.d.ts",
      "import": "./dist/brand.js"
    },
    "./settings-surface": {
      "types": "./dist/settings-surface.d.ts",
      "import": "./dist/settings-surface.js"
    },
    "./settings-surface.css": "./src/styles/settings-surface.css",
    "./styles.css": "./src/styles/index.css",
    "./styles/light.css": "./src/styles/light.css",
    "./styles/dark.css": "./src/styles/dark.css",
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "build": "tsc --build && node scripts/copy-static.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "1.48.0",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18"
  }
}
