{
  "name": "caelush",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm build && tsc -p tsconfig.json --noEmit && pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "check:architecture": "node scripts/architecture/check-boundaries.mjs",
    "check:architecture:verify": "node scripts/architecture/check-boundaries.mjs --verify-baseline",
    "check:architecture:readiness": "node scripts/architecture/check-migration-readiness.mjs",
    "check:architecture:ci": "pnpm check:architecture && pnpm check:architecture:verify && pnpm check:architecture:readiness",
    "check": "pnpm check:architecture && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm format:check",
    "test:web:e2e": "pnpm build && node scripts/web-session-browser-smoke.mjs",
    "build:release": "node scripts/build-release.mjs",
    "test:release": "node scripts/test-release.mjs"
  },
  "devDependencies": {
    "@caelush/llm": "workspace:*",
    "@caelush/runtime": "workspace:*",
    "@caelush/security": "workspace:*",
    "@caelush/tools": "workspace:*",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
