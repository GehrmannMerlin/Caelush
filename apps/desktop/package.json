{
  "name": "@caelush/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node scripts/build-local-agent.mjs && pnpm run typecheck && node scripts/build-main.mjs && vite build",
    "build:main": "node scripts/build-main.mjs",
    "dev": "node scripts/build-local-agent.mjs && pnpm run typecheck && node scripts/build-main.mjs && node scripts/dev.mjs",
    "start": "pnpm run build && node scripts/start.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:windows:vault": "node scripts/windows-vault-smoke.mjs"
  },
  "dependencies": {
    "@caelush/client": "workspace:*",
    "@caelush/protocol": "workspace:*",
    "lucide-react": "1.48.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "electron": "44.7.0",
    "esbuild": "0.25.10",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
