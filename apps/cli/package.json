{
  "name": "@caelush/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./args": {
      "types": "./dist/bootstrap/cli-args.d.ts",
      "import": "./dist/bootstrap/cli-args.js"
    },
    "./print": {
      "types": "./dist/application/print-host.d.ts",
      "import": "./dist/application/print-host.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@caelush/client": "workspace:*",
    "@caelush/protocol": "workspace:*",
    "ink": "7.1.1",
    "ink-text-input": "6.0.0",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "ink-testing-library": "4.0.0"
  }
}
