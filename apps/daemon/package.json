{
  "name": "@caelush/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./entry": {
      "types": "./dist/entry.d.ts",
      "import": "./dist/entry.js"
    },
    "./paths": {
      "types": "./dist/product-paths.d.ts",
      "import": "./dist/product-paths.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "import": "./dist/version.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@caelush/context": "workspace:*",
    "@caelush/core": "workspace:*",
    "@caelush/events": "workspace:*",
    "@caelush/llm": "workspace:*",
    "@caelush/memory": "workspace:*",
    "@caelush/protocol": "workspace:*",
    "@caelush/runtime": "workspace:*",
    "@caelush/security": "workspace:*",
    "@caelush/storage": "workspace:*",
    "@caelush/tools": "workspace:*",
    "@caelush/verification": "workspace:*",
    "@fastify/sse": "0.6.0",
    "fastify": "5.12.1",
    "fastify-type-provider-zod": "7.0.0"
  },
  "devDependencies": {
    "@caelush/client": "workspace:*"
  }
}
